            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/card6"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="10dp"
            android:gravity="center"
            android:text="6"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/card7"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="10dp"
