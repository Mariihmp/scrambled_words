<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_beach_win">

    <!-- Lottie Animation View (Full Screen) -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieAnimationView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/confettie" />

    <!-- TextView for "You Won" -->
    <TextView
        android:id="@+id/youWonTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You Won!"
        android:textSize="56sp"
        android:textColor="@color/dark_purple"
        android:textStyle="bold"
        android:fontFamily="@font/yay_holiday"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="250dp" />

    <LinearLayout
        android:id="@+id/scoreContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/youWonTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Custom Score Icon -->
        <ImageView
            android:id="@+id/scoreIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_star"
        android:contentDescription="Score Icon" />

        <!-- TextView for Score -->
        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="@color/dark_purple"
            android:textStyle="bold"
            android:fontFamily="@font/yay_holiday"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Back to Menu Button -->
    <Button
        android:id="@+id/backButton"
        android:text="Back to Menu"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:backgroundTint="@color/purple_200"
        android:layout_marginTop="50dp"
        app:cornerRadius="10dp"
        app:elevation="8dp"
        android:translationZ="8dp"
        android:layout_marginBottom="260dp"
        android:fontFamily="@font/yay_holiday"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>